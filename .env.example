# LLM API (Anthropic Claude / Google Gemini)
# Get your key from: https://console.anthropic.com or https://aistudio.google.com
LLM_PROVIDER=gemini
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Embedding model
EMBEDDING_MODEL=microsoft/BiomedNLP-PubMedBERT-base-uncased-abstract
EMBEDDING_DIM=768

# Reranker model
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# FAISS index
FAISS_INDEX_PATH=data/index/faiss_index.faiss
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=10

# DuckDB
DUCKDB_PATH=data/index/metadata.duckdb

# BM25
BM25_INDEX_PATH=data/index/bm25_index.pkl

# Streamlit
STREAMLIT_SERVER_PORT=8501
